{
  "name": "ui-hierarchy-mcp",
  "version": "0.2.0",
  "description": "MCP server that returns a Next.js App Router project's UI component hierarchy as a structured tree (markdown + JSON) so AI coding agents can ground image/description-based UI edits in exact file/component locations.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nextjs",
    "react",
    "ui",
    "component-hierarchy",
    "ast",
    "jsx",
    "tsx",
    "ai-tools",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "author": "huydv98",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dovanhuy2298/ui-to-hierarchy.git"
  },
  "bugs": {
    "url": "https://github.com/dovanhuy2298/ui-to-hierarchy/issues"
  },
  "homepage": "https://github.com/dovanhuy2298/ui-to-hierarchy#readme",
  "type": "module",
  "bin": {
    "ui-hierarchy-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run test/mcp/smoke.spawn.test.ts",
    "test:integration": "vitest run test/integration",
    "perf": "tsx test/perf/measure.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "get-tsconfig": "^4.14.0",
    "tinyglobby": "^0.2.16",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^4.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.4"
  }
}
