{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts", "vitest.config.ts"],
  "exclude": [
    "test/fixtures/parser/parse-errors/**",
    "test/fixtures/parser/resolver/**",
    "test/fixtures/parser/extractors/**"
  ]
}
