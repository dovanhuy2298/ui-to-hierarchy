{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "files": {
    "includes": [
      "src/**",
      "tsup.config.ts",
      "vitest.config.ts",
      "biome.json",
      "package.json",
      "tsconfig.json"
    ]
  },
  "overrides": [
    {
      "includes": ["src/ir/**", "src/renderers/**", "src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/adapters", "**/adapters/**", "**/mcp", "**/mcp/**"],
                    "message": "ARCH-01: ir/ renderers/ core/ must not import adapters/ or mcp/"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
